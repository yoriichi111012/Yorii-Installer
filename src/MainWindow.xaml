                        <GeometryDrawing Brush="#FFBDC9FF" Geometry="F1 M360,360z M0,0z M0,0C6.6,0 13.2,0 20,0 20,6.6 20,13.2 20,20 13.4,20 6.8,20 0,20 0,13.4 0,6.8 0,0z" />
                    </DrawingGroup>
                    <DrawingGroup Transform="1,0,0,1,280,20">
                        <GeometryDrawing Brush="#FF6D7A8C" Geometry="F1 M360,360z M0,0z M0,0C6.6,0 13.2,0 20,0 20,6.6 20,13.2 20,20 13.4,20 6.8,20 0,20 0,13.4 0,6.8 0,0z" />
                    </DrawingGroup>
                    <DrawingGroup Transform="1,0,0,1,260,20">
                        <GeometryDrawing Brush="#FFBDC9FF" Geometry="F1 M360,360z M0,0z M0,0C6.6,0 13.2,0 20,0 20,6.6 20,13.2 20,20 13.4,20 6.8,20 0,20 0,13.4 0,6.8 0,0z" />
                    </DrawingGroup>
                    <DrawingGroup Transform="1,0,0,1,160,20">
                        <GeometryDrawing Brush="#FF818CA9" Geometry="F1 M360,360z M0,0z M0,0C6.6,0 13.2,0 20,0 20,6.6 20,13.2 20,20 13.4,20 6.8,20 0,20 0,13.4 0,6.8 0,0z" />
                    </DrawingGroup>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>
        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background" Value="#ea9c80" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Padding" Value="24,6" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Root"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#d58f76" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#c1826c" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style
            x:Key="CancelButton"
            BasedOn="{StaticResource AccentButton}"
            TargetType="Button">
            <Setter Property="Background" Value="#454545" />
        </Style>

    </controls:MicaWindow.Resources>

    <Grid Margin="28,16,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel Orientation="Vertical">
                <TextBlock
                    Margin="0,0,0,8"
                    FontFamily="Segoe UI Variable Display, Segoe UI"
                    FontSize="28"
                    FontWeight="SemiBold"
                    Text="Yorii Launcher" />

                <TextBlock
                    x:Name="StatusText"
                    FontFamily="Segoe UI Variable Text, Segoe UI"
                    FontSize="14"
                    Foreground="#ea9c80"
                    Text="Ready to install"
                    TextWrapping="Wrap" />

                <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                    <controls:ProgressRing
                        x:Name="CertDownloadRing"
                        Width="12"
                        Height="12"
                        Margin="0,0,8,0"
                        IsIndeterminate="False"
                        Visibility="Hidden" />
                    <TextBlock
                        x:Name="DownloadCertificateText"
                        FontFamily="Segoe UI Variable Text, Segoe UI"
                        FontSize="14"
                        Foreground="#9E9E9E"
                        Text="Download certificate"
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                    <controls:ProgressRing
                        x:Name="CertInstallRing"
                        Width="12"
                        Height="12"
                        Margin="0,0,8,0"
                        IsIndeterminate="False"
                        Visibility="Hidden" />
                    <TextBlock
                        x:Name="InstallCertificateText"
                        FontFamily="Segoe UI Variable Text, Segoe UI"
                        FontSize="14"
                        Foreground="#9E9E9E"
                        Text="Install certificate"
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                    <controls:ProgressRing
                        x:Name="PackageDownloadRing"
                        Width="12"
                        Height="12"
                        Margin="0,0,8,0"
                        IsIndeterminate="False"
                        Visibility="Hidden" />
                    <TextBlock
                        x:Name="FetchLatestReleaseText"
                        FontFamily="Segoe UI Variable Text, Segoe UI"
                        FontSize="14"
                        Foreground="#9E9E9E"
                        Text="Download package"
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                    <controls:ProgressRing
                        x:Name="PackageInstallRing"
                        Width="12"
                        Height="12"
                        Margin="0,0,8,0"
                        IsIndeterminate="False"
                        Visibility="Hidden" />
                    <TextBlock
                        x:Name="LatestReleaseText"
                        FontFamily="Segoe UI Variable Text, Segoe UI"
                        FontSize="14"
                        Foreground="#9E9E9E"
                        Text="Install package"
                        TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>

            <Image
                Width="128"
                Height="128"
                Margin="0,6,10,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Source="{StaticResource Logo}" />
        </Grid>

        <StackPanel
            Grid.Row="1"
            Margin="0,32,12,0"
            VerticalAlignment="Bottom">

            <ProgressBar
                x:Name="ProgressBar"
                Foreground="#ea9c80"
                IsIndeterminate="False"
                Maximum="100"
                Minimum="0"
                Visibility="Hidden"
                Value="0" />
        </StackPanel>


        <StackPanel
            Grid.Row="2"
            Margin="0,0,16,16"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Orientation="Horizontal">
            <Button
                x:Name="InstallBtn"
                Width="120"
                Margin="0,0,12,0"
                Click="InstallBtn_Click"
                Content="Install"
                Style="{StaticResource AccentButton}" />

            <Button
                x:Name="CancelBtn"
                Width="120"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Click="CancelBtn_Click"
                Content="Cancel"
                Style="{StaticResource AccentButton}" />
        </StackPanel>
    </Grid>
</controls:MicaWindow>

